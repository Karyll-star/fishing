<view class="page">
  <view class="top"><view class="brand"><text class="mark">☼</text><view><text class="brand-name">潮汐手记</text><text class="brand-sub">荒岛钓鱼求生</text></view></view><view class="coins" bindtap="openShop">🪙 {{coins}}　＋</view></view>
  <view class="scene"><view class="sun"></view><text class="cloud">☁</text><view class="island"></view><text class="palm">🌴</text><text class="hut">🛖</text><view class="beach"></view><text class="person">🧍🏻‍♂️</text><view class="sea"><text class="bobber">{{bobber}}</text></view><view class="scenetitle"><text>{{islandName}}</text><text class="day">第 {{day}} 天 · {{weather}}</text></view><view class="scenehint">{{story}}</view></view>
  <view class="stats"><text>⚡ {{stamina}}/{{maxStamina}}</text><text>🎣 {{rodName}}</text><text>🧺 鱼获 {{fishCount}}</text></view>
  <view class="head"><view><text class="eyebrow">潮汐正在流动</text><text class="h1">{{activityTitle}}</text></view><text class="tag">{{areaName}}</text></view>
  <view class="fish-card"><view class="ring">{{fishIcon}}</view><text class="status">{{statusLine}}</text><view wx:if="{{mode==='fight'}}" class="meters"><text>鱼线拉力　{{tension}}%</text><view class="meter"><view style="width:{{tension}}%"></view></view><text>收线进度　{{progress}}%</text><view class="meter catch"><view style="width:{{progress}}%"></view></view></view><button class="action" bindtap="tapAction">{{actionLabel}}</button><text class="hint">{{actionHint}}</text><button wx:if="{{mode==='fight'}}" class="release" bindtap="releaseLine">松线卸力</button></view>
  <view class="actions"><button bindtap="openTrade">🧑‍🌾<text>交易</text></button><button bindtap="openBag">🎒<text>背包</text></button><button bindtap="challengeBoss">🐋<text>{{bossButton}}</text></button></view>
  <view class="adbox" bindtap="claimAd"><text class="boxicon">📦</text><view class="adcopy"><text>漂流补给箱</text><text class="small">看短片领取鱼饵与应急物资</text></view><text class="adbutton">看视频领</text><text class="adtag">广告</text></view>
  <view class="nav"><text class="selected">⌂ 营地</text><text bindtap="openTrade">⇄ 交易</text><text bindtap="openBag">▣ 背包</text><text bindtap="openPedia">◎ 图鉴</text></view>
  <view wx:if="{{panel}}" class="shade" bindtap="closePanel"><view class="sheet" catchtap="stop"><text class="close" bindtap="closePanel">×</text><text class="sheet-title">{{panelTitle}}</text><text class="sheet-desc">{{panelDesc}}</text>
    <block wx:if="{{panel==='trade'}}"><view class="panelrow" wx:for="{{tradeRows}}" wx:key="name"><text class="rowicon">{{item.icon}}</text><view class="rowcopy"><text>{{item.name}}</text><text class="rowdesc">{{item.desc}}</text></view><text class="qty">{{item.qty}}</text><button size="mini" data-action="{{item.action}}" bindtap="tradeAction">{{item.button}}</button></view></block>
    <block wx:if="{{panel==='bag'}}"><view class="panelrow"><text class="rowicon">🎣</text><view class="rowcopy"><text>{{rodName}}</text><text class="rowdesc">升级提高收线容错。{{upgradeDesc}}</text></view><button size="mini" bindtap="upgradeRod" disabled="{{!canUpgrade}}">{{canUpgrade?'升级':'材料不足'}}</button></view><view class="panelrow"><text class="rowicon">🪵</text><view class="rowcopy"><text>修船木料　×{{wood}}</text><text class="rowdesc">修船与制作工具</text></view></view><view class="panelrow"><text class="rowicon">🪢</text><view class="rowcopy"><text>结实绳索　×{{rope}}</text><text class="rowdesc">修船与远航物资</text></view></view><view class="panelrow"><text class="rowicon">🪱</text><view class="rowcopy"><text>鱼饵　×{{bait}}</text><text class="rowdesc">让浮漂更快有动静</text></view></view></block>
    <block wx:if="{{panel==='boss'}}"><view class="boss"><text class="bossemoji">{{bossEmoji}}</text><text class="bossname">{{bossName}}</text><text class="rowdesc">{{bossDesc}}</text></view><view wx:if="{{bossStage<3}}" class="bossactions"><button wx:for="{{bossChoices}}" wx:key="*this" data-choice="{{index}}" bindtap="bossAction">{{item}}</button></view><button wx:else class="primary full" bindtap="bossComplete">{{isLastIsland?'驶向救援信号':'启航去下一岛'}}</button></block>
    <block wx:if="{{panel==='ad'}}"><view class="boss"><text class="bossemoji">📦</text><text class="bossname">漂流补给箱</text><text class="rowdesc">模拟激励视频，不播放真实广告：鱼饵×2、体力+2、木料×1</text></view><button class="primary full" bindtap="adReward">模拟观看并领取</button></block>
    <block wx:if="{{panel==='shop'}}"><view class="boss"><text class="bossemoji">⛵</text><text class="bossname">演示商店</text><text class="rowdesc">日落船帆 · ¥6<br/>海风渔夫帽 · ¥3<br/>仅展示小程序内购位置，不会实际扣款</text></view><button class="primary full" bindtap="demoBuy">模拟购买装饰</button></block>
    <block wx:if="{{panel==='pedia'}}"><view class="pedia"><text wx:for="{{pedia}}" wx:key="name">{{item.found?'🐟':'❔'}} {{item.found?item.name:'未发现'}}　</text></view></block>
    <button class="secondary full" bindtap="closePanel">返回营地</button>
  </view></view><view wx:if="{{toast}}" class="toast">{{toast}}</view>
</view>